// Prisma schema for BOPET EDA 数据平台
// Database: SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

// ==================== 用户表 ====================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("normal") // superadmin, admin, normal
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dataRecords        DataRecord[]      @relation("CreatedBy")
  updatedDataRecords DataRecord[]      @relation("UpdatedBy")
  operationLogs     OperationLog[]
  departments       UserDepartment[]
  templates         FormTemplate[]
  uploadedAttachments DataAttachment[]
  importLogs        ImportLog[]
  fieldOptionConfigs FieldOptionConfig[]
  savedAnalyses     SavedAnalysis[]
  dashboards        AnalysisDashboard[]

  @@map("users")
}

// ==================== 用户部门关联表 ====================
model UserDepartment {
  id           Int                  @id @default(autoincrement())
  userId       Int
  departmentId Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   ResponsibleDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

// ==================== 产线表 ====================
model ProductionLine {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dataRecords DataRecord[]

  @@index([enabled, sortOrder])
  @@map("production_lines")
}

// ==================== 客户表 ====================
model Customer {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  shortName String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dataRecords DataRecord[]

  @@index([enabled, sortOrder])
  @@map("customers")
}

// ==================== 产品型号表 ====================
model ProductModel {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  thickness    String? // 厚度规格
  application  String? // 用途
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  dataRecords DataRecord[]

  @@index([enabled, sortOrder])
  @@map("product_models")
}

// ==================== 责任部门表 ====================
model ResponsibleDepartment {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dataRecords     DataRecord[]
  processes      ResponsibleProcess[]
  userDepartments UserDepartment[]
  formTemplates  FormTemplate[]
  fieldOptionConfigs FieldOptionConfig[]

  @@index([enabled, sortOrder])
  @@map("responsible_departments")
}

// ==================== 责任工序表 ====================
model ResponsibleProcess {
  id           Int                 @id @default(autoincrement())
  code         String              @unique
  name         String
  departmentId Int
  department   ResponsibleDepartment @relation(fields: [departmentId], references: [id])
  enabled      Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  dataRecords DataRecord[]

  @@index([departmentId, enabled, sortOrder])
  @@map("responsible_processes")
}

// ==================== 数据记录主表 ====================
model DataRecord {
  id                      Int      @id @default(autoincrement())
  dataNo                  String   @unique // 数据编号

  // 基础信息
  feedbackDate            DateTime // 反馈日期
  productionTime          DateTime? // 生产时间
  productModelId          Int?
  productModel            ProductModel? @relation(fields: [productModelId], references: [id])
  shaftCount              Int?      // 轴数
  thickness               String? // 厚度
  rollNo                  String? // 轴号
  specification           String? // 规格
  customerId              Int?
  customer                Customer? @relation(fields: [customerId], references: [id])
  quantityInvolved        Int?      // 涉及数量
  application             String? // 用途
  productionLineId        Int?
  productionLine          ProductionLine? @relation(fields: [productionLineId], references: [id])
  shiftTeam               String? // 班组
  machineNo               String? // 机台
  batchNo                 String? // 批次号

  // 记录内容
  feedbackContent         String? // 反馈内容
  category                String? // 数据分类
  closureStatus           String   @default("pending") // pending, processing, closed
  responsibleDeptId       Int?
  responsibleDept         ResponsibleDepartment? @relation(fields: [responsibleDeptId], references: [id])
  responsibleProcessId    Int?
  responsibleProcess      ResponsibleProcess? @relation(fields: [responsibleProcessId], references: [id])

  // 原因与改善
  rootCauseAnalysis       String? // 问题分析
  correctiveAction        String? // 纠正措施
  lessonsLearned          String? // 经验总结
  reviewConclusion        String? // 复盘结论
  productUsage            String? // 产品用途
  improvementAction       String? // 改善措施

  // 审计字段
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdById             Int?
  createdBy               User?    @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById             Int?
  updatedBy               User?    @relation("UpdatedBy", fields: [updatedById], references: [id])
  remark                  String? // 备注

  // 表单模板（支持多个）
  templateIds             String?  // JSON 数组: "[1,2,3]" 关联的模板ID列表
  templateData            String?  // 自定义字段值 JSON

  // 附件
  attachments             DataAttachment[]

  @@index([feedbackDate])
  @@index([customerId])
  @@index([productModelId])
  @@index([productionLineId])
  @@index([closureStatus])
  @@index([responsibleDeptId])
  @@index([category])
  @@index([responsibleDeptId, feedbackDate])
  @@map("data_records")
}

// ==================== 操作日志表 ====================
model OperationLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // create, update, delete
  module      String   // data, config
  targetId    Int?     // 操作对象ID
  targetName  String?  // 操作对象名称
  detail      String?  // 操作详情JSON
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([module, action])
  @@index([createdAt])
  @@map("operation_logs")
}

// ==================== 表单模板表 ====================
model FormTemplate {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  departmentId Int?      // null = 全局模板，所有部门可用
  createdById  Int?
  enabled      Boolean   @default(true)
  isDefault    Boolean   @default(false) // 是否为系统默认模板
  isPublic     Boolean   @default(false) // 是否为公开模板
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department   ResponsibleDepartment? @relation(fields: [departmentId], references: [id])
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  fields       FormTemplateField[]

  @@index([departmentId, enabled, sortOrder])
  @@map("form_templates")
}

// ==================== 表单模板字段表 ====================
model FormTemplateField {
  id           Int    @id @default(autoincrement())
  templateId   Int
  fieldKey     String   // 映射到 DataRecord 列名或自定义键名
  fieldLabel   String   // 显示标签
  fieldType    String   // text, textarea, number, select, date, switch, select-config, auto-complete, upload
  required     Boolean  @default(false)
  sortOrder    Int      @default(0)
  options      String?  // select 类型选项 JSON
  configType   String?  // select-config / auto-complete 时指定配置源
  defaultValue String?
  placeholder  String?

  template     FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldKey])
  @@index([templateId, sortOrder])
  @@map("form_template_fields")
}

// ==================== 数据附件表 ====================
model DataAttachment {
  id           Int      @id @default(autoincrement())
  dataId       Int
  fileName     String   // 文件名
  fileUrl      String   // 文件路径/URL
  storagePath  String   // OSS 内部存储路径（相对 OSS_ROOT）
  fileType     String   // image/png, application/pdf, video/mp4
  fileSize     Int      // 文件大小(字节)
  contentHash  String   // 文件内容 SHA-256
  width        Int?     // 图片宽度（仅图片）
  height       Int?     // 图片高度（仅图片）
  uploadedById Int?
  createdAt    DateTime @default(now())

  data         DataRecord @relation(fields: [dataId], references: [id], onDelete: Cascade)
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])

  @@index([dataId])
  @@map("data_attachments")
}

// ==================== 字段选项配置表（部门级下拉选项） ====================
model FieldOptionConfig {
  id           Int      @id @default(autoincrement())
  name         String   // 配置名称
  configKey    String   @unique // 唯一键
  options      String   // JSON数组字符串
  departmentId Int?     // null = 全局配置；非null = 部门级配置
  createdById  Int?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   ResponsibleDepartment? @relation(fields: [departmentId], references: [id])
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([departmentId, enabled])
  @@index([configKey])
  @@map("field_option_configs")
}

// ==================== 批量导入日志表 ====================
model ImportLog {
  id           Int      @id @default(autoincrement())
  fileName     String   // 导入文件名
  totalRows    Int      @default(0) // 总行数
  successCount Int      @default(0) // 成功条数
  errorCount   Int      @default(0) // 失败条数
  errors       String?  // 错误详情 JSON
  importedById Int?
  createdAt    DateTime @default(now())

  importedBy   User?    @relation(fields: [importedById], references: [id])

  @@map("import_logs")
}

// ==================== 用户保存的分析配置 ====================
model SavedAnalysis {
  id          Int                 @id @default(autoincrement())
  userId      Int
  name        String
  config      String              // JSON: { templateId, groupByField, fieldLabel, chartType, dateRange, limit }
  dashboardId Int?                // 所属看板（null = 独立面板）
  sortOrder   Int                 @default(0)
  gridW       Int                 @default(1)
  gridH       Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard   AnalysisDashboard?  @relation(fields: [dashboardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dashboardId])
  @@map("saved_analyses")
}

// ==================== 分析看板组合 ====================
model AnalysisDashboard {
  id          Int             @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  layout      String          @default("{}") // JSON: {"columns":2}
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    SavedAnalysis[]

  @@index([userId])
  @@map("analysis_dashboards")
}
