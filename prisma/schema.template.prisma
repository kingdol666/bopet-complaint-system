// Prisma schema for BOPET客诉闭环管理系统
// Database: __PRISMA_DB_LABEL__

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "__PRISMA_PROVIDER__"
  url      = env("__PRISMA_URL_ENV__")
__PRISMA_DIRECT_URL_LINE__}

// ==================== 用户表 ====================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("normal") // superadmin, admin, normal
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints        ComplaintRecord[]      @relation("CreatedBy")
  updatedComplaints ComplaintRecord[]      @relation("UpdatedBy")
  operationLogs     OperationLog[]
  departments       UserDepartment[]
  templates         FormTemplate[]
  uploadedAttachments ComplaintAttachment[]
  importLogs        ImportLog[]
  fieldOptionConfigs FieldOptionConfig[]
  savedAnalyses     SavedAnalysis[]

  @@map("users")
}

// ==================== 用户部门关联表 ====================
model UserDepartment {
  id           Int                  @id @default(autoincrement())
  userId       Int
  departmentId Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   ResponsibleDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

// ==================== 产线表 ====================
model ProductionLine {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("production_lines")
}

// ==================== 客户表 ====================
model Customer {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  shortName String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("customers")
}

// ==================== 产品型号表 ====================
model ProductModel {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  thickness    String? // 厚度规格
  application  String? // 用途
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("product_models")
}

// ==================== 问题大类表 ====================
model ProblemCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subcategories    ProblemSubcategory[]
  mappings         ComplaintProblemMapping[]
  complaintRecords ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("problem_categories")
}

// ==================== 问题小类表 ====================
model ProblemSubcategory {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  categoryId       Int
  category         ProblemCategory @relation(fields: [categoryId], references: [id])
  enabled          Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  mappings         ComplaintProblemMapping[]
  complaintRecords ComplaintRecord[]

  @@index([categoryId, enabled, sortOrder])
  @@map("problem_subcategories")
}

// ==================== 客户诉求表 ====================
model CustomerDemand {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("customer_demands")
}

// ==================== 质量赔偿方式表 ====================
model CompensationType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("compensation_types")
}

// ==================== 严重等级表 ====================
model SeverityLevel {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  level     Int      @default(1) // 1-5 等级
  color     String? // 显示颜色
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([enabled, sortOrder])
  @@map("severity_levels")
}

// ==================== 责任部门表 ====================
model ResponsibleDepartment {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints     ComplaintRecord[]
  processes      ResponsibleProcess[]
  userDepartments UserDepartment[]
  formTemplates  FormTemplate[]
  fieldOptionConfigs FieldOptionConfig[]

  @@index([enabled, sortOrder])
  @@map("responsible_departments")
}

// ==================== 责任工序表 ====================
model ResponsibleProcess {
  id           Int                 @id @default(autoincrement())
  code         String              @unique
  name         String
  departmentId Int
  department   ResponsibleDepartment @relation(fields: [departmentId], references: [id])
  enabled      Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  complaints ComplaintRecord[]

  @@index([departmentId, enabled, sortOrder])
  @@map("responsible_processes")
}

// ==================== 问题映射字典表 ====================
model ComplaintProblemMapping {
  id                   Int              @id @default(autoincrement())
  customerExpression   String // 客户表述
  keywordPattern       String? // 关键词/匹配词
  internalComplaintName String // 内部标准问题名称
  problemCategoryId    Int?
  problemCategory      ProblemCategory? @relation(fields: [problemCategoryId], references: [id])
  problemSubcategoryId Int?
  problemSubcategory   ProblemSubcategory? @relation(fields: [problemSubcategoryId], references: [id])
  enabled              Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([enabled])
  @@index([problemCategoryId])
  @@map("complaint_problem_mappings")
}

// ==================== 客诉记录主表 ====================
model ComplaintRecord {
  id                      Int      @id @default(autoincrement())
  complaintNo             String   @unique // 客诉编号

  // 基础信息
  feedbackDate            DateTime // 反馈日期
  productionTime          DateTime? // 生产时间
  productModelId          Int?
  productModel            ProductModel? @relation(fields: [productModelId], references: [id])
  shaftCount              Int?      // 轴数（正整数）
  thickness               String? // 厚度
  rollNo                  String? // 轴号
  specification           String? // 规格（如 100*970*3000）
  customerId              Int?
  customer                Customer? @relation(fields: [customerId], references: [id])
  quantityInvolved        Int?      // 涉及数量
  application             String? // 用途
  productionLineId        Int?
  productionLine          ProductionLine? @relation(fields: [productionLineId], references: [id])
  shiftTeam               String? // 班组
  machineNo               String? // 机台
  batchNo                 String? // 批次号

  // 客诉内容
  feedbackContent         String? // 反馈内容
  customerComplaintText   String? // 客诉问题（客户原始表述）
  internalComplaintName   String? // 客诉问题内部映射名称
  defectSource            String? // 弊病源（原材料、涂布工序、挤出工序等）
  specificDefect          String? // 具体不良点
  complaintCategory       String? // 客诉分类（成品外观、膜面平整性、涂布表观等）
  problemCategoryId       Int?
  problemCategory         ProblemCategory? @relation(fields: [problemCategoryId], references: [id])
  problemSubcategoryId    Int?
  problemSubcategory      ProblemSubcategory? @relation(fields: [problemSubcategoryId], references: [id])
  severityLevelId         Int?
  severityLevel           SeverityLevel? @relation(fields: [severityLevelId], references: [id])
  repeatedIssue           Boolean  @default(false) // 是否重复发生

  // 诉求与处置
  customerDemandId        Int?
  customerDemand          CustomerDemand? @relation(fields: [customerDemandId], references: [id])
  disposalResult          String? // 本例客诉处置结果
  compensationTypeId      Int?
  compensationType        CompensationType? @relation(fields: [compensationTypeId], references: [id])
  closureStatus           String   @default("pending") // pending, processing, closed
  responsibleDeptId       Int?
  responsibleDept         ResponsibleDepartment? @relation(fields: [responsibleDeptId], references: [id])
  responsibleProcessId    Int?
  responsibleProcess      ResponsibleProcess? @relation(fields: [responsibleProcessId], references: [id])

  // 原因与改善
  rootCauseAnalysis       String? // 问题分析（原因）
  correctiveAction        String? // 改善或者纠正措施
  lessonsLearned          String? // 启示
  reviewConclusion        String? // 复盘结论
  standardizedAction      Boolean  @default(false) // 是否形成标准化措施
  productUsage            String? // 产品用途
  improvementAction       String? // 改善措施

  // 审计字段
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdById             Int?
  createdBy               User?    @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById             Int?
  updatedBy               User?    @relation("UpdatedBy", fields: [updatedById], references: [id])
  remark                  String? // 备注

  // 表单模板（支持多个）
  templateIds             String?  // JSON 数组: "[1,2,3]" 关联的模板ID列表
  templateData            String?  // 自定义字段值 JSON

  // 附件
  attachments             ComplaintAttachment[]

  @@index([feedbackDate])
  @@index([customerId])
  @@index([productModelId])
  @@index([productionLineId])
  @@index([problemCategoryId])
  @@index([closureStatus])
  @@index([responsibleDeptId])
  @@map("complaint_records")
}

// ==================== 操作日志表 ====================
model OperationLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  action      String // create, update, delete
  module      String // complaint, config, mapping
  targetId    Int?     // 操作对象ID
  targetName  String? // 操作对象名称
  detail      String? // 操作详情JSON
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([module, action])
  @@index([createdAt])
  @@map("operation_logs")
}

// ==================== 表单模板表 ====================
model FormTemplate {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  departmentId Int?      // null = 全局模板，所有部门可用
  createdById  Int
  enabled      Boolean   @default(true)
  isDefault    Boolean   @default(false) // 是否为系统默认模板
  isPublic     Boolean   @default(false) // 是否为公开模板（部门模板可设为公开供查看）
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department   ResponsibleDepartment? @relation(fields: [departmentId], references: [id])
  createdBy    User                   @relation(fields: [createdById], references: [id])
  fields       FormTemplateField[]

  @@index([departmentId, enabled, sortOrder])
  @@map("form_templates")
}

// ==================== 表单模板字段表 ====================
model FormTemplateField {
  id           Int    @id @default(autoincrement())
  templateId   Int
  fieldKey     String   // 映射到 ComplaintRecord 列名或自定义键名
  fieldLabel   String   // 显示标签
  fieldType    String   // text, textarea, number, select, date, switch, select-config, auto-complete, upload
  required     Boolean  @default(false)
  sortOrder    Int      @default(0)
  options      String?  // select 类型选项 JSON: '["选项1","选项2"]'
  configType   String?  // select-config / auto-complete 时指定配置源
  defaultValue String?
  placeholder  String?

  template     FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldKey])
  @@index([templateId, sortOrder])
  @@map("form_template_fields")
}

// ==================== 客诉附件表 ====================
model ComplaintAttachment {
  id           Int      @id @default(autoincrement())
  complaintId  Int
  fileName     String   // 文件名
  fileUrl      String   // 文件路径/URL
  fileType     String   // image/png, application/pdf, video/mp4
  fileSize     Int      // 文件大小(字节)
  uploadedById Int?
  createdAt    DateTime @default(now())

  complaint    ComplaintRecord @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id])

  @@index([complaintId])
  @@map("complaint_attachments")
}

// ==================== 字段选项配置表（部门级下拉选项） ====================
model FieldOptionConfig {
  id           Int      @id @default(autoincrement())
  name         String   // 配置名称，如"弊病源选项"
  configKey    String   @unique // 唯一键，如"defect_source_options"
  options      String   // JSON数组字符串: '["选项1","选项2"]'
  departmentId Int?     // null = 全局配置；非null = 部门级配置
  createdById  Int
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   ResponsibleDepartment? @relation(fields: [departmentId], references: [id])
  createdBy    User                   @relation(fields: [createdById], references: [id])

  @@index([departmentId, enabled])
  @@index([configKey])
  @@map("field_option_configs")
}

// ==================== 批量导入日志表 ====================
model ImportLog {
  id           Int      @id @default(autoincrement())
  fileName     String   // 导入文件名
  totalRows    Int      @default(0) // 总行数
  successCount Int      @default(0) // 成功条数
  errorCount   Int      @default(0) // 失败条数
  errors       String?  // 错误详情 JSON
  importedById Int?
  createdAt    DateTime @default(now())

  importedBy   User?    @relation(fields: [importedById], references: [id])

  @@map("import_logs")
}

// ==================== 用户保存的分析配置 ====================
model SavedAnalysis {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  config    String   // JSON: { templateId, groupByField, fieldLabel, chartType, dateRange, limit }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_analyses")
}
