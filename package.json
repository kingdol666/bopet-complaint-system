{
  "name": "bopet-eda-platform",
  "version": "2.0.0",
  "description": "BOPET企业数据管理与分析平台",
  "private": true,
  "type": "module",
  "scripts": {
    "understand:graph": "node scripts/understand-generate-graph.mjs",
    "prisma:prepare": "node scripts/prepare-prisma-schema.mjs",
    "init": "node scripts/init.mjs",
    "build": "npm run prisma:prepare && node scripts/build.mjs",
    "dev": "npm run prisma:prepare && npx prisma generate && npx prisma db push && nuxt dev --port 3100",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "npm run prisma:prepare && nuxt prepare",
    "db:generate": "npm run prisma:prepare && prisma generate",
    "db:push": "npm run prisma:prepare && npx prisma db push",
    "db:migrate": "npm run prisma:prepare && prisma migrate dev --name init",
    "db:seed": "npm run prisma:prepare && npx prisma generate && tsx prisma/seed.ts",
    "db:studio": "npm run prisma:prepare && prisma studio",
    "db:reset": "npm run prisma:prepare && prisma migrate reset --force",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "dev:init": "npm run db:generate && npm run db:push && npm run db:seed && npm run dev",
    "dev:fresh": "npm run db:reset && npm run db:generate && npm run db:push && npm run db:seed && npm run dev",
    "deploy:vercel": "npm install && npx vercel --prod",
    "deploy:local": "npm install && npm run build && npm run preview",
    "postbuild": "node scripts/fix-unhead.mjs",
    "start": "node --env-file=.env.production scripts/start.mjs",
    "start:prod": "node --env-file=.env.production scripts/start.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop bopet-eda",
    "pm2:logs": "pm2 logs bopet-eda",
    "pm2:status": "pm2 status bopet-eda",
    "pm2:monit": "pm2 monit",
    "deploy": "bash scripts/deploy.sh",
    "deploy:update": "bash scripts/deploy.sh --update",
    "deploy:restart": "bash scripts/deploy.sh --restart"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.1",
    "@prisma/client": "^5.10.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "naive-ui": "^2.38.1",
    "nuxt": "^3.10.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-draggable-next": "2.3.0",
    "vue-echarts": "^6.6.9",
    "vue-router": "^4.2.5",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.11.0",
    "@types/node": "^20.11.0",
    "pm2": "^7.0.1",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vue-tsc": "^1.8.27"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
